const PLAYLIST_URL =
"https://ko-nek-tv.netlify.app/playlist.m3u";

const ALLOWED_APPS = [
  "OTT TV/",
  "OTT Navigator/",
  "OTT Player/",
  "OTTPlayer/"
];

const DEVICE_PREFIX = "device:";

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // ADMIN DASHBOARD
    if (url.pathname === "/admin") {
      return new Response(ADMIN_HTML, {
        headers: {
          "Content-Type": "text/html;charset=UTF-8"
        }
      });
    }

    // ADMIN LOGIN / DEVICE MANAGEMENT
    if (url.pathname.startsWith("/api/")) {
      return handleAdmin(request, env, url);
    }

    // PLAYLIST ACCESS
    if (
      url.pathname !== "/" &&
      url.pathname !== "/playlist.m3u"
    ) {
      return new Response("404 Not Found", {
        status: 404
      });
    }

    if (request.method !== "GET") {
      return new Response("Method Not Allowed", {
        status: 405
      });
    }

    const ua = request.headers.get("User-Agent") || "";

    // Check supported IPTV application
    const appAllowed = ALLOWED_APPS.some(app =>
      ua.startsWith(app)
    );

    if (!appAllowed) {
      return new Response("403 APP NOT ALLOWED", {
        status: 403
      });
    }

    // Extract device ID
    const match = ua.match(/\(([^()]*)\)\s*$/);

    if (!match) {
      return new Response("403 INVALID DEVICE ID", {
        status: 403
      });
    }

    const parts = match[1].split(";");
    const deviceId = parts[parts.length - 1].trim();

    if (!/^[A-Za-z0-9_-]{3,80}$/.test(deviceId)) {
      return new Response("403 INVALID DEVICE ID", {
        status: 403
      });
    }

    // Check Cloudflare KV authorization
    const device = await env.DEVICE_KV.get(
      DEVICE_PREFIX + deviceId
    );

    if (!device) {
      return new Response("403 DEVICE NOT AUTHORIZED", {
        status: 403
      });
    }

    // Fetch playlist only for authorized devices
    const response = await fetch(PLAYLIST_URL);

    if (!response.ok) {
      return new Response("Playlist unavailable", {
        status: 502
      });
    }

    return new Response(response.body, {
      status: 200,
      headers: {
        "Content-Type":
          response.headers.get("Content-Type") ||
          "application/vnd.apple.mpegurl",
        "Cache-Control": "no-store",
        "Access-Control-Allow-Origin": "*"
      }
    });
  }
};


// =================================
// ADMIN API
// =================================

async function handleAdmin(request, env, url) {

  const auth = request.headers.get("Authorization");

  if (
    !env.ADMIN_PASSWORD ||
    auth !== "Bearer " + env.ADMIN_PASSWORD
  ) {
    return json({ error: "Unauthorized" }, 401);
  }

  // LIST DEVICES
  if (
    url.pathname === "/api/devices" &&
    request.method === "GET"
  ) {
    const devices = [];

    let cursor;

    do {
      const result = await env.DEVICE_KV.list({
        prefix: DEVICE_PREFIX,
        cursor
      });

      for (const key of result.keys) {
        const value = await env.DEVICE_KV.get(key.name);

        if (value) {
          try {
            devices.push(JSON.parse(value));
          } catch {
            // Skip invalid records
          }
        }
      }

      cursor = result.list_complete
        ? undefined
        : result.cursor;

    } while (cursor);

    return json({ devices });
  }

  // ADD DEVICE
  if (
    url.pathname === "/api/devices" &&
    request.method === "POST"
  ) {
    let data;

    try {
      data = await request.json();
    } catch {
      return json({ error: "Invalid JSON" }, 400);
    }

    const id = String(data.id || "").trim();
    const name = String(data.name || "").trim();

    if (!/^[A-Za-z0-9_-]{3,80}$/.test(id)) {
      return json({ error: "Invalid device ID" }, 400);
    }

    if (name.length > 80) {
      return json({ error: "Device name too long" }, 400);
    }

    const key = DEVICE_PREFIX + id;

    const existing = await env.DEVICE_KV.get(key);

    if (existing) {
      return json({ error: "Device already exists" }, 409);
    }

    const device = {
      id,
      name: name || "IPTV Device",
      status: "ACTIVE",
      created: new Date().toISOString()
    };

    await env.DEVICE_KV.put(
      key,
      JSON.stringify(device)
    );

    return json({
      success: true,
      device
    });
  }

  // DELETE DEVICE
  if (
    url.pathname.startsWith("/api/devices/") &&
    request.method === "DELETE"
  ) {
    const id = decodeURIComponent(
      url.pathname.split("/").pop()
    );

    if (!/^[A-Za-z0-9_-]{3,80}$/.test(id)) {
      return json({ error: "Invalid device ID" }, 400);
    }

    await env.DEVICE_KV.delete(
      DEVICE_PREFIX + id
    );

    return json({
      success: true,
      message: "Device deleted"
    });
  }

  return json({ error: "Not Found" }, 404);
}


function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: {
      "Content-Type": "application/json",
      "Cache-Control": "no-store"
    }
  });
}


