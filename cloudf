<body>

<div class="container">

<h1>📺 KONEK TV</h1>
<h3 style="text-align:center">DEVICE AUTHORIZATION PANEL</h3>

<div class="card" id="login">

<h3>ADMIN LOGIN</h3>

<input
type="password"
id="password"
placeholder="Enter Admin Password"
>

<button onclick="login()">LOGIN</button>

<p id="loginMessage"></p>

</div>


<div id="dashboard" class="hidden">

<div class="card">

<h3>➕ ADD AUTHORIZED DEVICE</h3>

<input
id="deviceName"
placeholder="Device Name (Example: Living Room TV)"
>

<input
id="deviceId"
placeholder="Device ID (Example: 1fhvyi3)"
>

<button onclick="addDevice()">ADD DEVICE</button>

<p id="message"></p>

</div>


<div class="card">

<h3>📱 AUTHORIZED DEVICES</h3>

<p id="total">Total Devices: 0</p>

<div id="devices"></div>

<button onclick="loadDevices()">REFRESH DEVICES</button>

<button onclick="logout()" style="background:#555">
LOGOUT
</button>

</div>

<div class="card">

<h3>🔗 PLAYLIST URL</h3>

<input
readonly
value="/playlist.m3u"
onclick="this.select()"
>

<small>
Only registered device IDs from supported IPTV apps
can access the playlist.
</small>

</div>

</div>

</div>


<script>

let adminPassword = sessionStorage.getItem("konek_admin") || "";

async function api(path, method="GET", body=null){

const options = {
method,
headers:{
"Authorization":"Bearer "+adminPassword,
"Content-Type":"application/json"
}
};

if(body) options.body = JSON.stringify(body);

const response = await fetch(path,options);

const result = await response.json();

if(response.status === 401){
logout();
throw new Error("Unauthorized");
}

if(!response.ok){
throw new Error(result.error || "Request failed");
}

return result;

}


async function login(){

adminPassword = document.getElementById("password").value;

try{

await api("/api/devices");

sessionStorage.setItem("konek_admin",adminPassword);

document.getElementById("login").classList.add("hidden");

document.getElementById("dashboard").classList.remove("hidden");

loadDevices();

}catch(error){

document.getElementById("loginMessage").textContent =
"Login failed: "+error.message;

}

}


async function loadDevices(){

try{

const result = await api("/api/devices");

const devices = result.devices;

document.getElementById("total").textContent =
"Total Devices: "+devices.length;

const container = document.getElementById("devices");

container.innerHTML = "";

devices.forEach(device => {

const div = document.createElement("div");

div.className = "device";

const info = document.createElement("div");

const name = document.createElement("strong");
name.textContent = device.name;

const id = document.createElement("p");
id.textContent = "Device ID: "+device.id;

const status = document.createElement("span");
status.className = "status";
status.textContent = "● "+device.status;

info.append(name,id,status);

const button = document.createElement("button");
button.className = "delete";
button.textContent = "DELETE";

button.onclick = () => deleteDevice(device.id);

div.append(info,button);

container.appendChild(div);

});

}catch(error){

alert(error.message);

}

}


async function addDevice(){

const id = document.getElementById("deviceId").value.trim();

const name = document.getElementById("deviceName").value.trim();

try{

await api("/api/devices","POST",{id,name});

document.getElementById("message").textContent =
"✅ Device authorized successfully!";

document.getElementById("deviceId").value = "";
document.getElementById("deviceName").value = "";

loadDevices();

}catch(error){

document.getElementById("message").textContent =
"❌ "+error.message;

}

}


async function deleteDevice(id){

if(!confirm("Delete device "+id+"?")) return;

try{

await api("/api/devices/"+encodeURIComponent(id),"DELETE");

loadDevices();

}catch(error){

alert(error.message);

}

}


function logout(){

sessionStorage.removeItem("konek_admin");

adminPassword = "";

location.reload();

}


// Restore dashboard session

if(adminPassword){

login();

}

</script>

